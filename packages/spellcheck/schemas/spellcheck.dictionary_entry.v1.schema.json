{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "locale",
    "word",
    "normalized"
  ],
  "properties": {
    "schemaVersion": {
      "const": "spellcheck.dictionary_entry.v1"
    },
    "locale": {
      "enum": [
        "en-US",
        "es-ES"
      ]
    },
    "word": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "normalized": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    }
  }
}
