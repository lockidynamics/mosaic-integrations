        "inputSchemaId": "spellcheck.action_input.v1",
        "resultSchemaId": "spellcheck.command_result.v1"
      },
      "completion": {
        "label": "Spell Check",
        "stageLabel": "Check spelling",
        "reasons": [
          {
            "code": "PACKAGE_TEXT_DIAGNOSTICS_UNRESOLVED",
            "message": "Review or resolve the spelling issues highlighted by Spell Check before completing."
          },
          {
            "code": "PACKAGE_TEXT_DIAGNOSTICS_INCOMPLETE",
            "message": "Spell Check could not verify all saved text. Review the content and try again; if this continues, ask an Admin to update Spell Check."
          },
          {
            "code": "PACKAGE_TEXT_DIAGNOSTICS_EXECUTION_FAILED",
            "message": "Spell Check could not finish its completion check. Try again; if this continues, ask an Admin to update Spell Check."
          }
        ]
      }
