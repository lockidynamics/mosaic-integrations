{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "severity": { "enum": ["BLOCKER", "WARNING"] },
          "message": { "type": "string" }
        },
        "required": ["code", "severity", "message"],
        "additionalProperties": false
      }
    }
  },
  "required": ["diagnostics"],
  "additionalProperties": false
}
