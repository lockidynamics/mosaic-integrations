{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "artifactKind": { "type": "string" },
          "mediaType": { "type": "string" },
          "contentBase64": { "type": "string" }
        },
        "required": ["artifactKind", "mediaType", "contentBase64"],
        "additionalProperties": false
      }
    }
  },
  "required": ["artifacts"],
  "additionalProperties": false
}
