{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lockidynamics/mosaic/blob/main/public/schemas/mosaic-package-release-v2.schema.json",
  "title": "Mosaic Package Release v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "publisherKey",
    "packageKey",
    "catalogSlug",
    "version",
    "releaseDigest",
    "hostContract",
    "mosaicCompatibility",
    "artifacts",
    "interfaces",
    "capabilities",
    "contributions"
  ],
  "properties": {
    "$schema": { "type": "string", "maxLength": 255 },
    "schemaVersion": { "const": "mosaic-package-release-v2" },
    "publisherKey": { "$ref": "#/$defs/key" },
    "packageKey": { "$ref": "#/$defs/key" },
    "catalogSlug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": { "$ref": "#/$defs/semver" },
    "releaseDigest": { "$ref": "#/$defs/sha256" },
    "hostContract": { "const": "mosaic-package-host-v1" },
    "mosaicCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumVersion", "maximumVersion"],
      "properties": {
        "minimumVersion": { "$ref": "#/$defs/semver" },
        "maximumVersion": {
          "anyOf": [{ "$ref": "#/$defs/semver" }, { "type": "null" }]
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "interfaces": { "$ref": "#/$defs/interfaces" },
    "capabilities": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/capability" }
    },
    "contributions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/contribution" }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "identity": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,14})\\.(0|[1-9][0-9]{0,14})\\.(0|[1-9][0-9]{0,14})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "safePath": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[a-zA-Z0-9._-]+(?:/[a-zA-Z0-9._-]+)*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "mediaType", "byteSize", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "kind": {
          "enum": [
            "ui",
            "worker",
            "wasm",
            "schema",
            "fixture",
            "connector",
            "data"
          ]
        },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 100 },
        "byteSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "inputSchemaId", "resultSchemaId"],
      "properties": {
        "id": { "$ref": "#/$defs/identity" },
        "inputSchemaId": { "$ref": "#/$defs/identity" },
        "resultSchemaId": { "$ref": "#/$defs/identity" }
      }
    },
    "dataRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schemaId", "mode", "maxBytes"],
      "properties": {
        "id": { "$ref": "#/$defs/identity" },
        "schemaId": { "$ref": "#/$defs/identity" },
        "mode": {
          "enum": [
            "working-record",
            "immutable-version",
            "read-model",
            "artifact-metadata",
            "settings-record"
          ]
        },
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "scope": { "enum": ["global", "library"] },
        "recordIdMode": { "enum": ["fixed", "generated"] },
        "recordId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]{1,128}$"
        },
        "maxRecords": { "type": "integer", "minimum": 1, "maximum": 10000 }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "settings-record" } } },
          "then": {
            "required": ["scope", "recordIdMode", "maxRecords"],
            "allOf": [
              {
                "if": {
                  "properties": { "recordIdMode": { "const": "fixed" } }
                },
                "then": {
                  "required": ["recordId"],
                  "properties": { "maxRecords": { "const": 1 } }
                },
                "else": { "not": { "required": ["recordId"] } }
              }
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["scope"] },
                { "required": ["recordIdMode"] },
                { "required": ["recordId"] },
                { "required": ["maxRecords"] }
              ]
            }
          }
        }
      ]
    },
    "dataMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fromSchemaId", "toSchemaId", "workerOperationId"],
      "properties": {
        "id": { "$ref": "#/$defs/identity" },
        "fromSchemaId": { "$ref": "#/$defs/identity" },
        "toSchemaId": { "$ref": "#/$defs/identity" },
        "workerOperationId": { "$ref": "#/$defs/identity" }
      }
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uiBridge", "worker", "data", "connectorJobs"],
      "properties": {
        "uiBridge": { "type": "null" },
        "worker": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "artifactPath", "operations"],
              "properties": {
                "version": {
                  "enum": [
                    "mosaic-package-worker-v1",
                    "mosaic-package-worker-v2"
                  ]
                },
                "artifactPath": { "$ref": "#/$defs/safePath" },
                "resources": {
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["resourceId", "artifactPath"],
                    "properties": {
                      "resourceId": { "$ref": "#/$defs/identity" },
                      "artifactPath": { "$ref": "#/$defs/safePath" }
                    }
                  }
                },
                "operations": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "items": { "$ref": "#/$defs/operation" }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "version": { "const": "mosaic-package-worker-v2" }
                    }
                  },
                  "then": { "required": ["resources"] },
                  "else": { "not": { "required": ["resources"] } }
                }
              ]
            },
            { "type": "null" }
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "sourceCodecIdentity",
            "retainedSourceCodecIdentities",
            "records",
            "migrations"
          ],
          "properties": {
            "version": {
              "enum": ["mosaic-package-data-v1", "mosaic-package-data-v2"]
            },
            "sourceCodecIdentity": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "retainedSourceCodecIdentities": {
              "type": "array",
              "maxItems": 32,
              "items": { "type": "string", "minLength": 1, "maxLength": 100 }
            },
            "records": {
              "type": "array",
              "maxItems": 128,
              "items": { "$ref": "#/$defs/dataRecord" }
            },
            "migrations": {
              "type": "array",
              "maxItems": 64,
              "items": { "$ref": "#/$defs/dataMigration" }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "version": { "const": "mosaic-package-data-v1" }
                }
              },
              "then": {
                "properties": {
                  "records": {
                    "items": {
                      "properties": {
                        "mode": { "not": { "const": "settings-record" } }
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "connectorJobs": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "operations"],
              "properties": {
                "version": { "const": "mosaic-package-connector-job-v1" },
                "operations": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "items": { "$ref": "#/$defs/operation" }
                }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "description",
        "requestedScope",
        "requestedClassification"
      ],
      "properties": {
        "schemaVersion": { "const": "mosaic-package-capabilities-v1" },
        "id": {
          "type": "string",
          "maxLength": 129,
          "pattern": "^[a-z][a-z0-9_]{0,63}\\.[a-z][a-z0-9_]{0,63}$"
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "requestedScope": {
          "enum": ["global", "library", "campaign", "asset", "review"]
        },
        "requestedClassification": { "enum": ["standard", "privileged"] }
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "kind",
        "description",
        "requiredCapabilityId"
      ],
      "properties": {
        "schemaVersion": { "const": "mosaic-package-contributions-v1" },
        "id": { "$ref": "#/$defs/identity" },
        "kind": {
          "enum": [
            "native-surface",
            "text-diagnostics",
            "email-raster-region",
            "command",
            "governed-content-type",
            "read-model",
            "validator",
            "completion-target",
            "output",
            "artifact-kind",
            "preview-renderer",
            "asset-generator",
            "connector-operation"
          ]
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "requiredCapabilityId": {
          "anyOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }]
        },
        "nativeVersion": {
          "enum": [
            "mosaic-package-native-contributions-v1",
            "mosaic-package-native-contributions-v2"
          ]
        },
        "surface": {
          "enum": [
            "content-workspace",
            "builder-toolbar",
            "builder-inspector",
            "preview",
            "review"
          ]
        },
        "model": { "$ref": "#/$defs/nativeModel" },
        "modelOperation": { "$ref": "#/$defs/nativeOperationRef" },
        "commandOperation": { "$ref": "#/$defs/nativeOperationRef" },
        "evaluationOperation": { "$ref": "#/$defs/nativeOperationRef" },
        "completion": { "$ref": "#/$defs/packageCompletionPresentation" },
        "dataReads": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "readId",
              "contributionId",
              "recordTypeId",
              "recordId"
            ],
            "properties": {
              "readId": { "$ref": "#/$defs/identity" },
              "contributionId": { "$ref": "#/$defs/identity" },
              "recordTypeId": { "$ref": "#/$defs/identity" },
              "recordId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
              }
            }
          }
        },
        "scopedDataReads": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/scopedDataRead" }
        },
        "commandCapabilities": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/commandCapability" }
        },
        "entryPoint": { "$ref": "#/$defs/safePath" },
        "operationId": { "$ref": "#/$defs/identity" },
        "inputSchemaId": { "$ref": "#/$defs/identity" },
        "resultSchemaId": { "$ref": "#/$defs/identity" },
        "sourceCodecIdentity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sourceSchemaId": { "$ref": "#/$defs/identity" },
        "regionContract": { "const": "mosaic-email-raster-regions-v1" },
        "diagnosticsVersion": {
          "enum": ["mosaic-text-diagnostics-v1", "mosaic-text-diagnostics-v2"]
        },
        "enforcement": { "$ref": "#/$defs/textDiagnosticEnforcement" },
        "presentation": { "$ref": "#/$defs/textDiagnosticPresentation" },
        "actionOperation": { "$ref": "#/$defs/nativeOperationRef" },
        "locales": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["locale", "resourceIds"],
            "properties": {
              "locale": {
                "type": "string",
                "maxLength": 35,
                "pattern": "^[a-z]{2,3}(?:-[a-zA-Z0-9]{2,8})*$"
              },
              "resourceIds": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/identity" }
              }
            }
          }
        },
        "artifactKind": { "$ref": "#/$defs/identity" },
        "mediaTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 100000000 },
        "executionPlane": { "enum": ["worker", "connector-job"] }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "text-diagnostics" } } },
          "then": {
            "required": [
              "diagnosticsVersion",
              "locales",
              "operationId",
              "inputSchemaId",
              "resultSchemaId"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "diagnosticsVersion": {
                      "const": "mosaic-text-diagnostics-v2"
                    }
                  }
                },
                "then": {
                  "required": [
                    "scopedDataReads",
                    "enforcement",
                    "presentation",
                    "completion"
                  ],
                  "properties": {
                    "completion": {
                      "properties": {
                        "reasons": {
                          "allOf": [
                            {
                              "contains": {
                                "type": "object",
                                "required": ["code"],
                                "properties": {
                                  "code": { "const": "PACKAGE_TEXT_DIAGNOSTICS_UNRESOLVED" }
                                }
                              }
                            },
                            {
                              "contains": {
                                "type": "object",
                                "required": ["code"],
                                "properties": {
                                  "code": { "const": "PACKAGE_TEXT_DIAGNOSTICS_INCOMPLETE" }
                                }
                              }
                            },
                            {
                              "contains": {
                                "type": "object",
                                "required": ["code"],
                                "properties": {
                                  "code": { "const": "PACKAGE_TEXT_DIAGNOSTICS_EXECUTION_FAILED" }
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                },
                "else": {
                  "not": {
                    "anyOf": [
                      { "required": ["scopedDataReads"] },
                      { "required": ["enforcement"] },
                      { "required": ["presentation"] },
                      { "required": ["actionOperation"] }
                    ]
                  }
                }
              }
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["diagnosticsVersion"] },
                { "required": ["locales"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "email-raster-region" } }
          },
          "then": {
            "required": [
              "regionContract",
              "sourceSchemaId",
              "operationId",
              "inputSchemaId",
              "resultSchemaId",
              "completion"
            ],
            "properties": {
              "requiredCapabilityId": { "$ref": "#/$defs/identity" },
              "completion": {
                "properties": {
                  "reasons": {
                    "items": {
                      "properties": {
                        "code": {
                          "enum": [
                            "EMAIL_RASTER_WORKER_FAILED",
                            "EMAIL_RASTER_WORKER_PLAN_INVALID"
                          ]
                        }
                      }
                    },
                    "allOf": [
                      {
                        "contains": {
                          "type": "object",
                          "required": ["code"],
                          "properties": {
                            "code": { "const": "EMAIL_RASTER_WORKER_FAILED" }
                          }
                        }
                      },
                      {
                        "contains": {
                          "type": "object",
                          "required": ["code"],
                          "properties": {
                            "code": { "const": "EMAIL_RASTER_WORKER_PLAN_INVALID" }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "sandbox-workspace" }
            }
          },
          "then": { "required": ["entryPoint"] }
        },
        {
          "if": {
            "properties": { "kind": { "const": "native-surface" } }
          },
          "then": {
            "required": ["nativeVersion", "surface", "model"]
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "native-surface" } },
            "required": ["evaluationOperation"]
          },
          "then": {
            "required": ["completion"],
            "properties": {
              "completion": {
                "properties": {
                  "reasons": {
                    "allOf": [
                      {
                        "contains": {
                          "type": "object",
                          "required": ["code"],
                          "properties": {
                            "code": { "const": "PACKAGE_NATIVE_EVALUATION_EXECUTION_FAILED" }
                          }
                        }
                      },
                      {
                        "contains": {
                          "type": "object",
                          "required": ["code"],
                          "properties": {
                            "code": { "const": "PACKAGE_NATIVE_EVALUATION_BINDING_MISMATCH" }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "command",
                  "read-model",
                  "validator",
                  "completion-target",
                  "output",
                  "preview-renderer",
                  "connector-operation"
                ]
              }
            }
          },
          "then": {
            "required": ["operationId", "inputSchemaId", "resultSchemaId"]
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "governed-content-type" } }
          },
          "then": {
            "required": ["sourceCodecIdentity", "sourceSchemaId"]
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "artifact-kind" } }
          },
          "then": { "required": ["artifactKind", "mediaTypes", "maxBytes"] }
        },
        {
          "if": {
            "properties": { "kind": { "const": "asset-generator" } }
          },
          "then": {
            "required": [
              "operationId",
              "executionPlane",
              "inputSchemaId",
              "resultSchemaId"
            ]
          }
        }
      ]
    },
    "nativeOperationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "inputSchemaId", "resultSchemaId"],
      "properties": {
        "operationId": { "$ref": "#/$defs/identity" },
        "inputSchemaId": { "$ref": "#/$defs/identity" },
        "resultSchemaId": { "$ref": "#/$defs/identity" }
      }
    },
    "scopedDataRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readId", "scope", "recordTypeId", "mode"],
      "properties": {
        "readId": { "$ref": "#/$defs/identity" },
        "scope": { "enum": ["global", "library"] },
        "recordTypeId": { "$ref": "#/$defs/identity" },
        "mode": { "enum": ["record", "collection"] },
        "recordId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]{1,128}$"
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 10000 }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "record" } } },
          "then": {
            "required": ["recordId"],
            "not": { "required": ["limit"] }
          },
          "else": {
            "required": ["limit"],
            "not": { "required": ["recordId"] }
          }
        }
      ]
    },
    "commandCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandId", "requiredCapabilityId"],
      "properties": {
        "commandId": { "$ref": "#/$defs/identity" },
        "requiredCapabilityId": { "$ref": "#/$defs/identity" }
      }
    },
    "textDiagnosticEnforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readId", "booleanField", "defaultValue"],
      "properties": {
        "readId": { "$ref": "#/$defs/identity" },
        "booleanField": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$"
        },
        "defaultValue": { "type": "boolean" }
      }
    },
    "textDiagnosticPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "buttonLabel", "reviewLabel", "actions"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "buttonLabel": { "type": "string", "minLength": 1, "maxLength": 240 },
        "reviewLabel": { "type": "string", "minLength": 1, "maxLength": 240 },
        "actions": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/textDiagnosticAction" }
        }
      }
    },
    "packageCompletionPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "stageLabel", "reasons"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "stageLabel": { "type": "string", "minLength": 1, "maxLength": 100 },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_.-]{1,127}$"
              },
              "message": { "type": "string", "minLength": 1, "maxLength": 240 }
            }
          }
        }
      }
    },
    "textDiagnosticAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "requiredCapabilityId"],
      "properties": {
        "id": { "$ref": "#/$defs/identity" },
        "kind": { "enum": ["ignore", "add-to-scope"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "parentLabel": { "type": "string", "minLength": 1, "maxLength": 100 },
        "scope": { "enum": ["global", "library"] },
        "requiredCapabilityId": { "$ref": "#/$defs/identity" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "add-to-scope" } } },
          "then": { "required": ["parentLabel", "scope"] },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["parentLabel"] },
                { "required": ["scope"] }
              ]
            }
          }
        }
      ]
    },
    "nativeModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "surface", "items"],
      "properties": {
        "schemaVersion": {
          "enum": ["mosaic-package-native-model-v1", "mosaic-package-native-model-v2"]
        },
        "surface": {
          "enum": [
            "content-workspace",
            "builder-toolbar",
            "builder-inspector",
            "preview",
            "review"
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/nativeAction" },
              { "$ref": "#/$defs/nativeField" },
              { "$ref": "#/$defs/nativeProjection" },
              { "$ref": "#/$defs/nativeCollection" }
            ]
          }
        }
      }
    },
    "nativeAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "label", "icon"],
      "properties": {
        "kind": { "const": "action" },
        "id": { "$ref": "#/$defs/identity" },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "icon": {
          "enum": [
            "add",
            "edit",
            "delete",
            "duplicate",
            "image",
            "preview",
            "settings"
          ]
        },
        "commandId": { "$ref": "#/$defs/identity" },
        "disabled": { "type": "boolean" }
      }
    },
    "nativeField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "label", "control", "value"],
      "properties": {
        "kind": { "const": "field" },
        "id": { "$ref": "#/$defs/identity" },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "control": {
          "enum": ["text", "number", "select", "switch", "date"]
        },
        "value": {},
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 64 },
              "label": { "type": "string", "minLength": 1, "maxLength": 160 }
            }
          }
        },
        "commandId": { "$ref": "#/$defs/identity" },
        "disabled": { "type": "boolean" }
      }
    },
    "nativeProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "label", "value", "tone"],
      "properties": {
        "kind": { "const": "projection" },
        "id": { "$ref": "#/$defs/identity" },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "value": {},
        "tone": { "enum": ["neutral", "info", "success", "warning", "danger"] }
      }
    },
    "nativeCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "label", "searchable", "columns", "rows", "actions"],
      "properties": {
        "kind": { "const": "collection" },
        "id": { "$ref": "#/$defs/identity" },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "searchable": { "type": "boolean" },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
              "label": { "type": "string", "minLength": 1, "maxLength": 160 },
              "editable": { "type": "boolean" }
            }
          }
        },
        "rows": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "cells"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]{1,128}$" },
              "cells": { "type": "object" }
            }
          }
        },
        "actions": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "icon", "commandId"],
            "properties": {
              "id": { "$ref": "#/$defs/identity" },
              "label": { "type": "string", "minLength": 1, "maxLength": 160 },
              "icon": { "enum": ["edit", "delete"] },
              "commandId": { "$ref": "#/$defs/identity" },
              "disabled": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
