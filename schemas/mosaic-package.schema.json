{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lockidynamics/mosaic/blob/main/public/schemas/mosaic-package.schema.json",
  "title": "Mosaic Integration Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "description",
    "homepage",
    "logo",
    "mosaicVersion",
    "slug",
    "category"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,14})\\.(0|[1-9][0-9]{0,14})\\.(0|[1-9][0-9]{0,14})$"
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "homepage": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[^?#\\s]+$"
    },
    "logo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^:\\\\/?#]+(?:/[^:\\\\/?#]+)*\\.(?:[sS][vV][gG]|[pP][nN][gG]|[jJ][pP][eE]?[gG]|[wW][eE][bB][pP])$"
    },
    "mosaicVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,14})\\.(0|[1-9][0-9]{0,14})\\.(0|[1-9][0-9]{0,14})$"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "category": { "enum": ["authentication", "esp", "email", "workflow"] },
    "renderContributions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceCodecIdentity",
          "outputs",
          "trigger",
          "requestCapability",
          "deliveryCapability",
          "profileId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "maxLength": 160
          },
          "sourceCodecIdentity": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "maxLength": 100
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["jpeg"] }
          },
          "trigger": { "enum": ["after-save", "on-demand"] },
          "requestCapability": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "maxLength": 160
          },
          "deliveryCapability": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "maxLength": 160
          },
          "profileId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "maxLength": 160
          }
        }
      }
    }
  }
}
